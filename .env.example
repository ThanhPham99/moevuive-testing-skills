# ==============================================================================
# CLAUDE & ANTIGRAVITY TESTING SKILLS — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in project-specific values.
# NEVER commit .env with real credentials or tokens to Git.
# ==============================================================================

# --- 1. TARGET APPLICATION UNDER TEST (SUT) ---
BASE_URL=https://staging.example.com
ADMIN_EMAIL=qa_admin@example.com
ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUN

# --- 2. BROWSER EXECUTION & AUTOMATION RUNNER ---
# Headless Mode (true = 1920x1080 GPU-off default | false = 1600x750 visible window)
HEADLESS=true
# Video Evidence Mode (retain-on-failure | on | off)
VIDEO_MODE=retain-on-failure
# Parallel execution workers (canonical default = 5 for stateless tests)
WORKERS=5

# --- 3. JIRA INTEGRATION (/fetch-jira-requirements & /create-bug-report) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=PROJ

# Option A: Jira Cloud (Basic Auth with Email + API Token from id.atlassian.com)
JIRA_EMAIL=qa@example.com
JIRA_API_TOKEN=ATATT3xFfGF0_replace_with_your_token

# Option B: Jira Server / Data Center (Personal Access Token — leave empty if using Cloud)
# JIRA_PAT=MzI0_replace_with_your_personal_access_token

# --- 4. XRAY TEST MANAGEMENT (/import-test-results-xray) ---
# Platform: cloud (default) | server
XRAY_PLATFORM=cloud

# Xray Cloud API Keys (create at app.getxray.app -> Settings -> API Keys)
XRAY_CLIENT_ID=replace_with_xray_client_id
XRAY_CLIENT_SECRET=replace_with_xray_client_secret
